{
	"name": "nestjs-service-template",
	"description": "📜 My template for creating NestJS Services",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"prebuild": "rimraf dist",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepublish:git": "npm run build",
		"publish:git": "release-it",
		"prepare": "husky",
		"build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
		"format": "prettier --write \"{src,apps,libs,test}/**/*.ts\"",
		"start": "tsx src/main.ts",
		"start:dev": "tsx watch src/main.ts",
		"start:debug": "node --watch --inspect --import tsx src/main.ts",
		"start:prod": "node dist/main.js",
		"lint": "oxlint --type-aware --deny-warnings src test",
		"lint:fix": "npm run lint -- --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:debug": "node --inspect-brk ./node_modules/vitest/vitest.mjs run --no-file-parallelism --maxWorkers 1",
		"test:ci": "vitest run --coverage"
	},
	"lint-staged": {
		"*.ts": [
			"npm run format",
			"npm run lint:fix"
		]
	},
	"directories": {
		"test": "test"
	},
	"main": "./dist/main.js",
	"types": "./dist/main.d.ts",
	"keywords": [],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SocketSomeone/nestjs-service-template.git"
	},
	"bugs": {
		"url": "https://github.com/SocketSomeone/nestjs-service-template"
	},
	"author": "Alexey Filippov <socket.someone@gmail.com>",
	"contributors": [
		"Alexey Filippov <socket.someone@gmail.com>"
	],
	"dependencies": {
		"@nestjs/axios": "^12.0.0",
		"@nestjs/common": "12.0.1",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "12.0.1",
		"@nestjs/jwt": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/swagger": "^12.0.1",
		"axios": "^1.20.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-angular": "21.2.2",
		"@nestjs/testing": "^12.0.1",
		"@release-it/conventional-changelog": "^12.0.0",
		"@types/node": "26.4.1",
		"@vitest/coverage-v8": "5.0.0",
		"eslint": "^10.10.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-prettier": "5.5.6",
		"husky": "9.1.7",
		"lint-staged": "17.5.0",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"release-it": "^21.0.2",
		"rimraf": "6.1.3",
		"tsc-alias": "1.9.4",
		"tsx": "4.23.13",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	},
	"engines": {
		"node": "^20.19.0 || >=22.13.0",
		"npm": ">=8.6.0"
	}
}
